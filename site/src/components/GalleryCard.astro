---
import type { Locale } from "../i18n/types";
import type { AutreProduit } from "../data/products";

interface Props {
  product: AutreProduit;
  locale: Locale;
}
const { product, locale } = Astro.props;
---

<article id={product.slug} class="gc">
  <div class="gc-photo">
    <picture>
      <source type="image/webp" srcset={`/images/${product.image}.webp`} />
      <img src={`/images/${product.image}.jpg`} alt={product.name[locale]} loading="lazy" decoding="async" />
    </picture>
  </div>
  <div class="gc-body">
    <h3 class="gc-name">{product.name[locale]}</h3>
  </div>
</article>

<style>
  .gc {
    display: flex; flex-direction: column; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm);
    scroll-margin-top: 100px;
  }
  /* Cadre CARRÉ figé : image en absolu pour qu'un visuel portrait n'étire pas la carte.
     object-fit:contain = produit montré en entier (portrait des huiles + paysage des poudres). */
  .gc-photo { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: var(--color-surface-alt); }
  .gc-photo picture { position: absolute; inset: 0; }
  .gc-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 14px; display: block; }

  .gc-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; flex: 1; }
  .gc-name { font-family: var(--font-display); font-weight: 700; font-size: 17px; line-height: 1.25; color: var(--color-text); margin: 0; }
</style>
