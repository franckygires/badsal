---
import type { Dict, Locale } from "../i18n/types";
import { localizePath } from "../i18n";
import { site, whatsappLink } from "../data/site";

interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const t = dict;
const L = (p: string) => localizePath(p, locale);
const legalHref = L("/mentions-legales");
const legalLabel = { fr: "Mentions légales", en: "Legal notice", zh: "法律声明", ar: "إشعار قانوني" }[locale];

const navLinks = [
  { label: t.nav.home, href: "/" },
  { label: t.nav.about, href: "/qui-sommes-nous" },
  { label: t.nav.exportLabel, href: "/exportation" },
  { label: t.nav.importLabel, href: "/importation" },
  { label: t.nav.vision, href: "/vision" },
  { label: t.nav.contact, href: "/contact" },
];
---

<footer class="site-footer">
  <div class="container section-pad footer-grid">
    <!-- Marque -->
    <div>
      <div class="f-brand">
        <span class="f-badge">
          <picture>
            <source type="image/webp" srcset="/images/logo-neutre.webp" />
            <img src="/images/logo-neutre.jpg" alt="" />
          </picture>
        </span>
        <span class="f-name">BADSAL &amp; FILS<br />OKIKIOLA</span>
      </div>
      <p class="f-tagline">{t.footer.tagline}</p>
      {(site.social.linkedin || site.social.facebook) && (
        <div class="f-social">
          {site.social.linkedin && (
            <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
          )}
          {site.social.facebook && (
            <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Navigation -->
    <div>
      <h4 class="f-title">{t.footer.navTitle}</h4>
      <div class="f-nav">
        {navLinks.map((l) => <a href={L(l.href)}>{l.label}</a>)}
      </div>
    </div>

    <!-- Contact -->
    <div>
      <h4 class="f-title">{t.footer.contactTitle}</h4>
      <p class="f-address">{t.footer.addressLines.map((line) => <>{line}<br /></>)}</p>
      <div class="f-channels">
        <a class="chan wa" href={whatsappLink()} target="_blank" rel="noopener">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24zm-3.4 4.43c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.57.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06z"/></svg>
          WhatsApp · {site.whatsappNumbers[0]}
        </a>
        <button class="chan we" type="button" data-wechat={site.wechatId} title="WeChat — afficher le QR code">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.69 4C4.62 4 1.3 6.74 1.3 10.14c0 1.93 1.07 3.65 2.74 4.8l-.55 1.7 2.02-1.04c.72.22 1.45.36 2.18.4-.13-.45-.2-.92-.2-1.4 0-2.98 2.84-5.36 6.32-5.36.23 0 .45.01.67.03C13.9 6.32 11.55 4 8.69 4zm-2.4 3.2a.92.92 0 1 1 0 1.84.92.92 0 0 1 0-1.84zm4.84 0a.92.92 0 1 1 0 1.84.92.92 0 0 1 0-1.84zM14.1 9.6c-3 0-5.45 2.04-5.45 4.56s2.45 4.56 5.45 4.56c.62 0 1.23-.1 1.81-.28l1.67.86-.46-1.42c1.36-.96 2.23-2.42 2.23-4.06 0-2.52-2.45-4.56-5.25-4.56z"/></svg>
          <span class="we-label">WeChat · {site.wechatId}</span>
        </button>
        <a class="chan mail" href={`mailto:${site.email}`}>
          <span class="mail-at" aria-hidden="true">@</span>
          {site.email}
        </a>
      </div>
    </div>
  </div>

  <div class="container section-pad f-bottom">
    <span class="f-badge-legal">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5l1.7 1.1 2-.2.6 1.9 1.6 1.2-.7 1.9.7 1.9-1.6 1.2-.6 1.9-2-.2L8 14.5l-1.7-1.1-2 .2-.6-1.9L2.1 10.5l.7-1.9-.7-1.9 1.6-1.2.6-1.9 2 .2L8 1.5z" fill="currentColor" opacity="0.25"/><path d="M5.6 8.1l1.6 1.6 3.3-3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      RCCM : {site.rccm} &nbsp;|&nbsp; IFU : {site.ifu}
    </span>
    <span class="f-copy">{t.footer.copyright}</span><a class="f-legal-link" href={legalHref}>{legalLabel}</a>
  </div>
</footer>

<style>
  .site-footer { background: #071a2c; color: rgba(255, 255, 255, 0.72); padding-top: 64px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 48px; padding-bottom: 48px; }

  .f-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .f-badge {
    background: var(--color-logo-bg); border: 1px solid rgba(182, 110, 38, 0.42); border-radius: 8px;
    padding: 6px 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .f-badge img { height: 28px; width: auto; display: block; }
  .f-name { font-family: var(--font-display); font-weight: 700; font-size: 17px; color: var(--color-accent); line-height: 1.2; }
  .f-tagline { font-size: 14px; line-height: 1.65; color: rgba(255, 255, 255, 0.6); margin: 0; max-width: 320px; }
  .f-social { display: flex; gap: 12px; margin-top: 18px; }
  .f-social a {
    width: 38px; height: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.06); color: rgba(255, 255, 255, 0.8);
    transition: background var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard);
  }
  .f-social a:hover { background: rgba(182, 110, 38, 0.18); color: var(--color-accent-soft); }

  .f-title { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-soft); margin: 0 0 18px; }
  .f-nav { display: flex; flex-direction: column; gap: 11px; }
  .f-nav a { font-size: 14px; color: rgba(255, 255, 255, 0.72); text-decoration: none; }
  .f-nav a:hover { color: var(--color-accent-soft); }
  .f-address { font-size: 14px; color: rgba(255, 255, 255, 0.7); margin: 0 0 16px; line-height: 1.6; }

  .f-channels { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .chan {
    display: inline-flex; align-items: center; gap: 9px; color: #fff; font-family: var(--font-body);
    font-size: 14px; font-weight: 600; padding: 10px 16px; border-radius: 6px; text-decoration: none;
    border: none; cursor: pointer; transition: background var(--dur-base) var(--ease-standard);
  }
  .chan.wa { background: var(--color-whatsapp); }
  .chan.wa:hover { background: var(--color-whatsapp-deep); }
  .chan.we { background: var(--color-wechat); }
  .chan.we:hover { background: var(--color-wechat-deep); }
  .chan.mail { background: rgba(255, 255, 255, 0.06); color: var(--color-accent-soft); }
  .mail-at { width: 17px; text-align: center; font-size: 19px; font-weight: 700; line-height: 1; }
  .chan.mail:hover { background: rgba(255, 255, 255, 0.1); }

  .f-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 22px; padding-bottom: 30px;
    display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
  }
  .f-badge-legal {
    display: inline-flex; align-items: center; gap: 8px; background: rgba(182, 110, 38, 0.14);
    border: 1px solid rgba(182, 110, 38, 0.42); color: var(--color-accent-soft); font-size: 12.5px;
    font-weight: 500; padding: 7px 14px; border-radius: 999px; letter-spacing: 0.02em;
  }
  .f-copy { font-size: 13px; color: rgba(255, 255, 255, 0.45); }
  .f-legal-link { color: rgba(255,255,255,.62); font-size:12px; text-decoration:none; }
  .f-legal-link:hover { color: var(--color-accent-soft); }

  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>

<!-- Le clic sur le bouton WeChat ouvre la modale QR (gérée par WeChatModal.astro). -->

