---
import type { Locale } from "../i18n/types";
import { site } from "../data/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const caption: Record<Locale, string> = {
  fr: "Scannez le QR code pour nous ajouter sur WeChat",
  en: "Scan the QR code to add us on WeChat",
  zh: "扫一扫二维码，添加我们的微信",
  ar: "امسح رمز QR لإضافتنا على WeChat",
};
const copyLabel: Record<Locale, string> = {
  fr: "Copier l'identifiant",
  en: "Copy ID",
  zh: "复制微信号",
  ar: "نسخ المعرّف",
};
const copiedLabel: Record<Locale, string> = {
  fr: "Identifiant copié ✓",
  en: "Copied ✓",
  zh: "已复制 ✓",
  ar: "تم النسخ ✓",
};
const closeLabel: Record<Locale, string> = {
  fr: "Fermer",
  en: "Close",
  zh: "关闭",
  ar: "إغلاق",
};
---

<div class="wm" id="wechat-modal" hidden>
  <div class="wm-backdrop" data-wm-close></div>
  <div class="wm-card" role="dialog" aria-modal="true" aria-label="WeChat">
    <button class="wm-close" type="button" data-wm-close aria-label={closeLabel[locale]}>×</button>
    <div class="wm-head">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="#07C160" aria-hidden="true"><path d="M8.69 4C4.62 4 1.3 6.74 1.3 10.14c0 1.93 1.07 3.65 2.74 4.8l-.55 1.7 2.02-1.04c.72.22 1.45.36 2.18.4-.13-.45-.2-.92-.2-1.4 0-2.98 2.84-5.36 6.32-5.36.23 0 .45.01.67.03C13.9 6.32 11.55 4 8.69 4zm-2.4 3.2a.92.92 0 1 1 0 1.84.92.92 0 0 1 0-1.84zm4.84 0a.92.92 0 1 1 0 1.84.92.92 0 0 1 0-1.84zM14.1 9.6c-3 0-5.45 2.04-5.45 4.56s2.45 4.56 5.45 4.56c.62 0 1.23-.1 1.81-.28l1.67.86-.46-1.42c1.36-.96 2.23-2.42 2.23-4.06 0-2.52-2.45-4.56-5.25-4.56z"/></svg>
      <span>WeChat</span>
    </div>
    <img class="wm-qr" src={site.wechatQr} alt="QR code WeChat — BADSAL & FILS OKIKIOLA" width="240" height="240" loading="lazy" />
    <p class="wm-caption">{caption[locale]}</p>
    <button class="wm-copy" type="button" data-wechat-copy={site.wechatId} data-copy-label={copyLabel[locale]} data-copied-label={copiedLabel[locale]}>
      {site.wechatId} · {copyLabel[locale]}
    </button>
  </div>
</div>

<style>
  .wm {
    position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 20px;
  }
  .wm[hidden] { display: none; }
  .wm-backdrop { position: absolute; inset: 0; background: rgba(13, 36, 25, 0.55); backdrop-filter: blur(2px); }
  .wm-card {
    position: relative; z-index: 1; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 16px; box-shadow: 0 24px 60px rgba(20, 48, 38, 0.28); padding: 28px 28px 24px;
    width: 320px; max-width: 100%; text-align: center;
    animation: wmIn 180ms var(--ease-standard);
  }
  @keyframes wmIn { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }
  .wm-close {
    position: absolute; top: 10px; inset-inline-end: 12px; width: 32px; height: 32px; border: none; background: transparent;
    font-size: 26px; line-height: 1; color: var(--color-text-muted); cursor: pointer; border-radius: 8px;
  }
  .wm-close:hover { background: var(--color-surface-alt); }
  .wm-head { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--color-text); margin-bottom: 16px; }
  .wm-qr {
    width: 240px; height: 240px; max-width: 100%; object-fit: contain; border-radius: 10px;
    border: 1px solid var(--color-border); background: #fff;
  }
  .wm-caption { font-size: 14px; line-height: 1.5; color: var(--color-text-muted); margin: 14px 0 16px; }
  .wm-copy {
    width: 100%; background: var(--color-wechat); color: #fff; border: none; border-radius: 8px;
    padding: 11px 14px; font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;
    transition: background var(--dur-base) var(--ease-standard);
  }
  .wm-copy:hover { background: var(--color-wechat-deep); }
</style>

<script>
  const modal = document.getElementById("wechat-modal");
  if (modal) {
    const open = () => { modal.hidden = false; document.body.style.overflow = "hidden"; };
    const close = () => { modal.hidden = true; document.body.style.overflow = ""; };

    // Ouvre la modale depuis n'importe quel bouton WeChat (footer, carte contact…)
    document.querySelectorAll("[data-wechat]").forEach((btn) => {
      btn.addEventListener("click", (e) => { e.preventDefault(); open(); });
    });

    modal.querySelectorAll("[data-wm-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) close(); });

    // Bouton « copier l'identifiant »
    const copyBtn = modal.querySelector(".wm-copy");
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const id = copyBtn.getAttribute("data-wechat-copy") || "";
        const copy = copyBtn.getAttribute("data-copy-label") || "";
        const copied = copyBtn.getAttribute("data-copied-label") || "";
        try {
          await navigator.clipboard.writeText(id);
          copyBtn.textContent = copied;
          setTimeout(() => { copyBtn.textContent = id + " · " + copy; }, 1600);
        } catch (e) { /* presse-papiers indisponible */ }
      });
    }
  }
</script>
