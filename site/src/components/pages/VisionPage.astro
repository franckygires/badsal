---
import type { Locale } from "../../i18n/types";
import { getDict, localizePath } from "../../i18n";
import Base from "../../layouts/Base.astro";
import PageHero from "../PageHero.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = getDict(locale);
const v = dict.vision;
const title = `${dict.nav.vision} — BADSAL & FILS OKIKIOLA`;
---

<Base locale={locale} dict={dict} path="/vision" active="vision" title={title} description={v.statement}>
  <PageHero
    locale={locale}
    homeLabel={dict.common.breadcrumbHome}
    breadcrumb={v.breadcrumb}
    title={v.heroTitle}
    kicker={v.heroKicker}
  />

  <!-- Énoncé de vision -->
  <section class="statement section-pad">
    <div class="container statement-inner">
      <span class="quote-mark">“</span>
      <p class="statement-text">{v.statement}</p>
      <span class="bar"></span>
    </div>
  </section>

  <section class="vision-axes section-pad">
  <div class="container axes-inner">
    <span class="axes-kicker">{v.projectsKicker}</span>
    <div class="axes-grid">
      {v.projects.slice(0, 3).map((project) => <div><span>{project.num}</span><h3>{project.raw}</h3><p>{project.desc}</p></div>)}
    </div>
  </div>
</section>

  <!-- Projets de transformation -->
  <section class="projects section-pad">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{v.projectsKicker}</span>
        <h2 class="sec-title">{v.projectsTitle}</h2>
        <span class="bar center"></span>
      </div>
      <div class="proj-grid">
        {v.projects.map((p) => (
          <div class="proj-card">
            <span class="proj-num">{p.num}</span>
            <div class="proj-flow">
              <span class="proj-raw">{p.raw}</span>
              <span class="proj-arrow">→</span>
              <span class="proj-product">{p.product}</span>
            </div>
            <p class="proj-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta section-pad">
    <div class="container cta-card">
      <div class="cta-glow"></div>
      <div class="cta-inner">
        <span class="cta-kicker">{v.ctaKicker}</span>
        <h2 class="cta-title">{v.ctaTitle}</h2>
        <p class="cta-sub">{v.ctaSub}</p>
        <div class="cta-actions">
          <a class="btn-gold" href={localizePath("/contact", locale)}>{v.ctaBtn}</a>
          <a class="btn-ghost" href={localizePath("/contact", locale)}>{v.ctaBtn2}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .eyebrow { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent-soft); }
  .sec-title { font-family: var(--font-display); font-weight: 700; font-size: 34px; color: #fff; margin: 12px 0 0; }
  .bar { display: inline-block; width: 64px; height: 3px; background: var(--color-accent); border-radius: 999px; }
  .bar.center { margin-top: 16px; }

  /* Statement */
  .statement { background: var(--color-bg); padding-top: 96px; padding-bottom: 96px; }
  .statement-inner { max-width: 980px; margin: 0 auto; text-align: left; }
  .quote-mark { font-family: var(--font-display); font-size: 90px; line-height: 0.6; color: var(--color-accent); opacity: 0.35; display: block; height: 48px; }
  .statement-text { font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 34px; line-height: 1.45; color: var(--color-text); margin: 0; }
  .statement .bar { margin-top: 32px; width: 72px; }

  /* Projets */
  .projects { background: var(--color-primary); padding-top: 90px; padding-bottom: 90px; }
  .sec-head { text-align: left; margin-bottom: 54px; }
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 26px; }
  .proj-card { background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(184, 134, 11, 0.32); border-radius: 14px; padding: 32px 32px 30px; }
  .proj-num { display: inline-block; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; color: var(--color-accent-soft); margin-bottom: 18px; }
  .proj-flow { display: flex; align-items: center; gap: 18px; margin-bottom: 18px; }
  .proj-raw, .proj-product { flex: 1; text-align: center; font-family: var(--font-display); font-size: 21px; border-radius: 10px; padding: 16px 12px; }
  .proj-raw { font-weight: 600; color: rgba(255, 255, 255, 0.82); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); }
  .proj-product { font-weight: 700; color: var(--color-primary); background: var(--color-accent-soft); }
  .proj-arrow { font-size: 26px; color: var(--color-accent); flex-shrink: 0; }
  .proj-desc { font-size: 14.5px; line-height: 1.6; color: rgba(255, 255, 255, 0.72); margin: 0; }

  /* CTA */
  .cta { background: var(--color-bg); padding-top: 96px; padding-bottom: 96px; }
  .cta-card { background: linear-gradient(120deg, var(--color-primary-deep), var(--color-primary) 60%, var(--color-primary-soft));
    border-radius: 18px; padding: 64px 56px; text-align: left; position: relative; overflow: hidden; box-shadow: 0 18px 48px rgba(20, 48, 38, 0.18); }
  .cta-glow { position: absolute; right: -60px; top: -80px; width: 300px; height: 300px; border-radius: 50%;
    background: radial-gradient(circle, rgba(184, 134, 11, 0.22), transparent 70%); }
  .cta-inner { position: relative; z-index: 2; }
  .cta-kicker { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent-soft); margin-bottom: 18px; }
  .cta-title { font-family: var(--font-display); font-weight: 700; font-size: 31px; line-height: 1.18; color: #fff; max-width: 740px; margin: 0; }
  .cta-sub { font-size: 17px; line-height: 1.6; color: rgba(255, 255, 255, 0.8); max-width: 600px; margin: 20px 0 0; }
  .cta-actions { display: flex; gap: 14px; justify-content: flex-start; margin-top: 34px; flex-wrap: wrap; }
  .btn-gold, .btn-ghost { display: inline-flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600;
    padding: 15px 32px; border-radius: 6px; text-decoration: none; transition: background var(--dur-base) var(--ease-standard); }
  .btn-gold { background: var(--color-accent); color: #fff; box-shadow: 0 4px 16px rgba(184, 134, 11, 0.35); }
  .btn-gold:hover { background: var(--color-accent-deep); }
  .btn-ghost { background: transparent; color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.7); }
  .btn-ghost:hover { background: rgba(255, 255, 255, 0.12); }


  .vision-axes { background: #e7e8e5; padding-top: 58px; padding-bottom: 58px; }
  .axes-kicker { display:block; color: var(--color-accent-deep); font-size:11px; font-weight:800; letter-spacing:.16em; text-align:center; text-transform:uppercase; }
  .axes-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:27px; }
  .axes-grid > div { padding:22px 24px; background:rgba(255,255,255,.62); border-left:2px solid var(--color-accent); }
  .axes-grid span { color:var(--color-accent); font-size:12px; font-weight:800; letter-spacing:.13em; }
  .axes-grid h3 { margin:9px 0 0; color:var(--color-primary-deep); font-size:16px; }
  .axes-grid p { margin:8px 0 0; color:var(--color-text-muted); font-size:13px; line-height:1.55; }
  @media (max-width: 820px) {
  .vision-axes { background: #e7e8e5; padding-top: 58px; padding-bottom: 58px; }
  .axes-kicker { display:block; color: var(--color-accent-deep); font-size:11px; font-weight:800; letter-spacing:.16em; text-align:center; text-transform:uppercase; }
  .axes-grid { display:grid; grid-template-columns:1fr; gap:22px; margin-top:27px; }
  .axes-grid > div { padding:22px 24px; background:rgba(255,255,255,.62); border-left:2px solid var(--color-accent); }
  .axes-grid span { color:var(--color-accent); font-size:12px; font-weight:800; letter-spacing:.13em; }
  .axes-grid h3 { margin:9px 0 0; color:var(--color-primary-deep); font-size:16px; }
  .axes-grid p { margin:8px 0 0; color:var(--color-text-muted); font-size:13px; line-height:1.55; }

    .proj-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .statement-text { font-size: 24px; }
    .cta-title { font-size: 28px; }
    .cta-card { padding: 44px 24px; }
  }
</style>
