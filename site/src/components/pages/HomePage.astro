---
import type { Locale } from "../../i18n/types";
import { getDict, localizePath } from "../../i18n";
import { flagshipProducts, productImage } from "../../data/products";
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";
import HeroSlider from "../HeroSlider.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = getDict(locale);
const t = dict;

const labels = {
  fr: {
    registered: "Entreprise enregistrée", ifu: "IFU", location: "Ancrage", trade: "Commerce international", talk: "Parler à un conseiller",
    investTitle: "Investissez dans nos différents projets", investBody: "Nous recherchons des investisseurs et partenaires pour accompagner nos projets de transformation locale et développer de nouvelles filières à forte valeur ajoutée.", investBtn: "Découvrir nos projets",
  },
  en: {
    registered: "Registered company", ifu: "Tax ID", location: "Based in", trade: "International trade", talk: "Talk to an advisor",
    investTitle: "Invest in our projects", investBody: "We are seeking investors and partners to support our local-processing projects and develop new high-value supply chains.", investBtn: "Discover our projects",
  },
  zh: {
    registered: "注册企业", ifu: "税号", location: "所在地", trade: "国际贸易", talk: "咨询顾问",
    investTitle: "投资我们的项目", investBody: "我们正在寻找投资者和合作伙伴，共同支持本地加工项目并发展新的高附加值产业链。", investBtn: "了解我们的项目",
  },
  ar: {
    registered: "شركة مسجلة", ifu: "الرقم الضريبي", location: "مقرنا", trade: "التجارة الدولية", talk: "تحدث إلى مستشار",
    investTitle: "استثمروا في مشاريعنا المختلفة", investBody: "نبحث عن مستثمرين وشركاء لمواكبة مشاريعنا في التحويل المحلي وتطوير سلاسل قيمة جديدة.", investBtn: "اكتشفوا مشاريعنا",
  }
}[locale];
---
<Base locale={locale} dict={dict} path="/" active="home" title={t.home.intro.title + " — BADSAL & FILS OKIKIOLA"} description={t.home.intro.body}>
  <HeroSlider locale={locale} dict={dict} />
  <section class="trust section-pad"><div class="container trust-inner"><div><span>{labels.registered}</span><strong>RCCM {site.rccm}<small>{labels.ifu} {site.ifu}</small></strong></div><div><span>{labels.location}</span><strong>Cotonou · Bénin</strong></div><div><span>{labels.trade}</span><strong>Incoterms CIF &amp; FOB</strong></div><a href={localizePath("/contact", locale)}>{labels.talk} <b>→</b></a></div></section>
  <section class="intro section-pad"><div class="container intro-grid"><div><h2>{t.home.intro.title}</h2></div><div class="intro-copy"><p>{t.home.intro.body}</p><a class="text-link" href={localizePath("/qui-sommes-nous", locale)}>{t.common.learnMore} <b>→</b></a></div></div></section>
  <section class="business-lines section-pad"><div class="container"><div class="lines-grid"><article class="line-card export-card"><h3>{t.home.pillars[0].title}</h3><p>{t.home.pillars[0].desc}</p><a href={localizePath("/exportation", locale)}>{t.common.learnMore} <b>→</b></a></article><article class="line-card import-card"><h3>{t.home.pillars[1].title}</h3><p>{t.home.pillars[1].desc}</p><a href={localizePath("/importation", locale)}>{t.common.learnMore} <b>→</b></a></article></div></div></section>
  <section id="produits" class="products section-pad"><div class="container"><div class="products-top"><div class="section-heading"><span class="eyebrow">{t.home.productsTitle}</span><h2>{t.home.productsTitle}</h2><i class="rule"></i></div><p>{t.home.productsSub}</p></div><div class="product-grid">{flagshipProducts.map((product) => { const image = productImage(product.slug); return <a class="product-card" href={localizePath("/exportation", locale) + "#" + product.slug}><div class="product-image">{image && <picture><source type="image/webp" srcset={"/images/" + image + ".webp"} /><img src={"/images/" + image + ".jpg"} alt={product.name[locale]} loading="lazy" /></picture>}</div><div class="product-info"><small>{t.common.learnMore}</small><h3>{product.name[locale]}</h3><b>{t.common.learnMore} <em>→</em></b></div></a>; })}</div><div class="products-footer"><a class="outline-btn" href={localizePath("/contact", locale)}>{t.common.requestQuote} <b>→</b></a></div></div></section>
  <section class="method section-pad"><div class="container method-grid"><div class="method-copy"><span class="eyebrow">{t.contact.form.kicker}</span><h2>{t.contact.form.title}</h2><i class="rule"></i><p>{t.contact.heroSub}</p><a class="text-link light" href={localizePath("/contact", locale)}>{t.common.requestQuote} <b>→</b></a></div><ol class="steps"><li><span>01</span><div><h3>{t.contact.form.product}</h3><p>{t.contact.form.productPh}</p></div></li><li><span>02</span><div><h3>{t.contact.form.qty}</h3><p>{t.contact.form.qtyPh}</p></div></li><li><span>03</span><div><h3>{t.contact.form.incoterm}</h3><p>{t.contact.form.incotermPh}</p></div></li></ol></div></section>
  <section class="vision section-pad"><div class="container vision-inner"><span>{t.home.bannerKicker}</span><h2>{t.vision.heroTitle}</h2><p>{t.home.bannerText}</p><a href={localizePath("/vision", locale)}>{t.home.bannerBtn} <b>→</b></a></div></section>
  <section class="closing section-pad"><div class="container closing-inner"><div><h2>{labels.investTitle}</h2></div><div><p>{labels.investBody}</p><a class="closing-btn" href={localizePath("/vision", locale)}>{labels.investBtn} <b>→</b></a></div></div></section>
</Base>
<style>
  .eyebrow{display:block;color:var(--color-accent);font-size:11px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}.rule{display:block;width:52px;height:2px;margin-top:21px;background:var(--color-accent)}h2{margin:15px 0 0;color:var(--color-primary-deep);font-family:var(--font-display);font-size:clamp(32px,3.2vw,46px);font-weight:400;letter-spacing:-.04em;line-height:1.08}.trust{background:#fff;border-bottom:1px solid var(--color-border)}.trust-inner{display:grid;grid-template-columns:1.06fr .9fr 1.05fr auto;align-items:stretch}.trust-inner>div,.trust-inner>a{padding:24px 26px;border-inline-end:1px solid var(--color-border)}.trust-inner>div:first-child{padding-left:0}.trust span{display:block;margin-bottom:7px;color:var(--color-text-faint);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.trust strong{display:flex;flex-direction:column;gap:4px;color:var(--color-primary-deep);font-size:13px}.trust strong small{color:var(--color-text-muted);font-size:11px;font-weight:700}.trust a{display:flex;align-items:center;gap:18px;border:0;color:var(--color-primary);font-size:13px;font-weight:800;text-decoration:none;white-space:nowrap}.trust a b,.text-link b,.line-card b,.outline-btn b,.vision b,.closing-btn b{color:var(--color-accent);font-size:21px}.intro{padding-top:126px;padding-bottom:124px;background:var(--color-surface)}.intro-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:58px;align-items:start}.intro-copy{padding-top:8px}.intro-copy p,.products-top>p,.method-copy>p,.vision p,.closing p{color:var(--color-text-muted);font-size:17px;line-height:1.72}.text-link{display:inline-flex;align-items:center;gap:14px;margin-top:18px;color:var(--color-primary);font-size:13px;font-weight:800;text-decoration:none}.business-lines{padding-top:84px;padding-bottom:120px;background:#e8e9e7}.section-heading{max-width:760px}.lines-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:0}.line-card{min-height:430px;padding:43px 46px;color:#fff;position:relative;overflow:hidden}.line-card::after{content:"";position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-122px;bottom:-178px}.export-card{background:linear-gradient(140deg,#0e314c,#11253a)}.import-card{background:linear-gradient(140deg,#58635f,#31423f)}.line-card h3{position:relative;z-index:1;max-width:470px;margin:0;font-family:var(--font-display);font-size:37px;font-weight:500;letter-spacing:-.04em;line-height:1.1}.line-card p{position:relative;z-index:1;max-width:480px;margin-top:28px;color:rgba(255,255,255,.82);font-size:15px;line-height:1.68}.line-card a{position:absolute;z-index:1;bottom:40px;display:inline-flex;gap:13px;color:#fff;font-size:13px;font-weight:800;text-decoration:none}.products{padding-top:116px;padding-bottom:110px;background:var(--color-surface)}.products-top{display:flex;justify-content:space-between;align-items:end;gap:54px}.products-top>p{max-width:390px;margin:0}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:54px}.product-card{background:#fff;text-decoration:none;box-shadow:0 8px 20px rgba(13,28,45,.05);transition:transform var(--dur-base) var(--ease-standard),box-shadow var(--dur-base) var(--ease-standard)}.product-card:hover{transform:translateY(-6px);box-shadow:0 20px 34px rgba(13,28,45,.12)}.product-image{position:relative;aspect-ratio:1/1.08;overflow:hidden;background:#d6d8d2}.product-image picture,.product-image img{width:100%;height:100%;display:block}.product-image img{object-fit:cover;transition:transform 500ms var(--ease-standard)}.product-card:hover .product-image img{transform:scale(1.05)}.product-info{padding:20px 19px 22px}.product-info small{color:var(--color-text-faint);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.product-info h3{min-height:50px;margin:9px 0 15px;color:var(--color-primary-deep);font-family:var(--font-display);font-size:22px;font-weight:400;line-height:1.1}.product-info>b{display:flex;justify-content:space-between;color:var(--color-primary);font-size:12px}.product-info em{color:var(--color-accent);font-size:18px;font-style:normal}.products-footer{margin-top:42px;text-align:center}.outline-btn{display:inline-flex;gap:15px;align-items:center;min-height:48px;padding:0 21px;border:1px solid var(--color-primary);color:var(--color-primary);font-size:12px;font-weight:800;text-decoration:none}.method{padding-top:112px;padding-bottom:110px;background:var(--color-primary-deep)}.method-grid{display:grid;grid-template-columns:1fr 1.07fr;gap:94px}.method h2{color:#fff}.method-copy>p{max-width:470px;color:rgba(255,255,255,.68)}.method .light{color:#fff}.steps{margin:0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.2)}.steps li{display:grid;grid-template-columns:84px 1fr;gap:17px;padding:28px 0;border-bottom:1px solid rgba(255,255,255,.2)}.steps li>span{color:#ddb66d;font-family:var(--font-display);font-size:20px}.steps h3{margin:0;color:#fff;font-size:16px}.steps p{margin:8px 0 0;color:rgba(255,255,255,.64);font-size:14px}.vision{background:#d5c1a0;padding-top:83px;padding-bottom:85px}.vision-inner{max-width:760px;text-align:center}.vision-inner>span{color:#705421;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.vision h2{margin-top:15px}.vision p{max-width:640px;margin:20px auto 0;color:#443d30}.vision a{display:inline-flex;gap:14px;margin-top:18px;color:var(--color-primary);font-size:13px;font-weight:800;text-decoration:none}.closing{padding-top:92px;padding-bottom:94px;background:#fff}.closing-inner{display:grid;grid-template-columns:1.3fr .7fr;align-items:end;gap:58px}.closing p{margin:0}.closing-btn{display:inline-flex;gap:15px;align-items:center;margin-top:20px;min-height:51px;padding:0 23px;background:var(--color-primary);color:#fff;font-size:13px;font-weight:800;text-decoration:none}@media(max-width:900px){.trust-inner{grid-template-columns:1fr 1fr}.trust-inner>div:first-child{padding-left:26px}.trust a{grid-column:1/-1;border-top:1px solid var(--color-border);justify-content:center}.intro-grid,.method-grid,.closing-inner{grid-template-columns:1fr;gap:30px}.intro-copy{padding-top:0}.products-top{display:block}.products-top>p{margin-top:22px}.product-grid{grid-template-columns:repeat(2,1fr)}.method-grid{gap:55px}.lines-grid{grid-template-columns:1fr}.closing-inner{align-items:start}.line-card{min-height:400px}}@media(max-width:560px){.trust-inner{grid-template-columns:1fr}.trust-inner>div{border-inline-end:0;border-bottom:1px solid var(--color-border)}.trust a{grid-column:auto}.intro,.business-lines,.products,.method{padding-top:75px;padding-bottom:75px}.line-card{padding:33px 25px}.line-card h3{font-size:30px}.line-card p{font-size:14px}.line-card a{bottom:30px}.product-grid{gap:12px}.product-info{padding:16px 13px}.product-info h3{font-size:19px}.vision,.closing{padding-top:68px;padding-bottom:68px}}
</style>