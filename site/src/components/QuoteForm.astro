---
import type { Dict, Locale } from "../i18n/types";
import { products, autresProducts } from "../data/products";

interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const f = dict.contact.form;
const formEndpoint = "https://api.badsal-okikiola-fils.be/devis";
const turnstileSiteKey = "0x4AAAAAAD-icvnFmsGLpVqh";
const customProduct = {
  fr: { option: "Autre produit (à préciser)", label: "Produit à préciser", placeholder: "Indiquez le produit recherché" },
  en: { option: "Other product (please specify)", label: "Product to specify", placeholder: "Enter the product you are looking for" },
  zh: { option: "其他产品（请说明）", label: "待说明的产品", placeholder: "请输入您要寻找的产品" },
  ar: { option: "منتج آخر (يرجى التحديد)", label: "المنتج المطلوب توضيحه", placeholder: "اذكر المنتج الذي تبحث عنه" },
}[locale];
---

<section class="quote-section section-pad">
  <div class="container quote-card">
    <div class="quote-head">
      <span class="kicker">{f.kicker}</span>
      <h2 class="quote-title">{f.title}</h2>
      <span class="underline"></span>
    </div>

    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <form class="quote-form" id="quote-form" data-endpoint={formEndpoint}>
      <input type="hidden" name="locale" value={locale} />
      <!-- anti-spam (honeypot) -->
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

      <label class="field">
        <span>{f.name}</span>
        <input type="text" name="name" placeholder={f.namePh} required />
      </label>
      <label class="field">
        <span>{f.company}</span>
        <input type="text" name="company" placeholder={f.companyPh} />
      </label>
      <label class="field">
        <span>{f.email}</span>
        <input type="email" name="email" placeholder={f.emailPh} required />
      </label>
      <label class="field">
        <span>{f.product}</span>
        <select name="product" id="product-select" required>
          <option value="" disabled selected>{f.productPh}</option>
          {products.map((p) => (
            <option value={p.name[locale]} data-slug={p.slug}>{p.name[locale]}</option>
          ))}
          {autresProducts.map((p) => (
            <option value={p.name[locale]} data-slug={p.slug}>{p.name[locale]}</option>
          ))}
          <option value="__other__">{customProduct.option}</option>
        </select>
      </label>
      <label class="field field-other-product" id="product-other-field" hidden>
        <span>{customProduct.label}</span>
        <input type="text" name="product_other" placeholder={customProduct.placeholder} disabled />
      </label>
      <label class="field">
        <span>{f.qty}</span>
        <input type="text" name="quantity" placeholder={f.qtyPh} />
      </label>
      <label class="field">
        <span>{f.incoterm}</span>
        <select name="incoterm" required>
          <option value="" disabled selected>{f.incotermPh}</option>
          {dict.contact.incoterms.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
      <label class="field field-full">
        <span>{f.message}</span>
        <textarea name="message" rows="4" placeholder={f.messagePh}></textarea>
      </label>

      <div class="turnstile field-full">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-action="quote"></div>
      </div>
      <div class="form-foot">
        <button class="submit" type="submit">{f.submit} <span class="rtl-arrow">→</span></button>
        <p class="form-status" role="status" aria-live="polite"
           data-sending={f.sending} data-success={f.success} data-error={f.error}></p>
      </div>
    </form>
  </div>
</section>

<style>
  .quote-section { background: var(--color-bg); padding-top: 40px; padding-bottom: 96px; }
  .quote-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 18px; box-shadow: 0 8px 28px rgba(26, 26, 26, 0.06); padding: 52px 56px; }
  .quote-head { text-align: center; margin-bottom: 40px; }
  .kicker { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); }
  .quote-title { font-family: var(--font-display); font-weight: 700; font-size: 32px; color: var(--color-text); margin: 12px 0 0; }
  .underline { display: inline-block; width: 64px; height: 3px; background: var(--color-accent); border-radius: 999px; margin-top: 16px; }

  .quote-form { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 28px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field-full { grid-column: 1 / -1; }
  .field-other-product { grid-column: 1 / -1; }
  .field > span { font-size: 13px; font-weight: 600; color: var(--color-text); }
  .field input, .field select, .field textarea {
    font-family: var(--font-body); font-size: 15px; color: var(--color-text); padding: 13px 15px;
    border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-bg); width: 100%;
  }
  .field textarea { resize: vertical; }
  .field select { cursor: pointer; }
  .field input::placeholder, .field textarea::placeholder { color: #9a9c94; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.15);
  }
  .hp { display: none !important; }
  .turnstile { display: flex; justify-content: center; }

  .form-foot { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; gap: 16px; margin-top: 14px; }
  .submit {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px; background: var(--color-accent);
    color: #fff; font-family: var(--font-body); font-size: 16px; font-weight: 600; padding: 16px 36px;
    border: 1.5px solid var(--color-accent); border-radius: 8px; cursor: pointer;
    box-shadow: 0 4px 16px rgba(184, 134, 11, 0.32); transition: background var(--dur-base) var(--ease-standard);
  }
  .submit:hover { background: var(--color-accent-deep); }
  .submit:disabled { opacity: 0.6; cursor: progress; }
  .form-status { margin: 0; font-size: 14.5px; font-weight: 500; text-align: center; }
  .form-status.ok { color: var(--color-primary); }
  .form-status.err { color: #9a3412; }

  @media (max-width: 700px) {
    .quote-card { padding: 32px 22px; }
    .quote-form { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>(".form-status")!;
    const submitBtn = form.querySelector<HTMLButtonElement>(".submit")!;
    const submitLabel = submitBtn.innerHTML;

    const select = form.querySelector<HTMLSelectElement>("#product-select");
    const otherField = form.querySelector<HTMLElement>("#product-other-field");
    const otherInput = otherField?.querySelector<HTMLInputElement>("input[name=product_other]");
    const toggleOtherProduct = () => {
      const active = select?.value === "__other__";
      if (otherField) otherField.hidden = !active;
      if (otherInput) {
        otherInput.disabled = !active;
        otherInput.required = !!active;
      }
    };

    // Présélection du produit depuis ?produit=<slug>
    const slug = new URLSearchParams(location.search).get("produit");
    if (slug) {
      const opt = select?.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
      if (select && opt) select.value = opt.value;
    }
    select?.addEventListener("change", toggleOtherProduct);
    toggleOtherProduct();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.className = "form-status";
      status.textContent = status.dataset.sending ?? "";
      submitBtn.disabled = true;
      submitBtn.textContent = status.dataset.sending ?? "";  // texte simple pendant l'envoi
      try {
        const res = await fetch(form.dataset.endpoint || "/api/devis", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (data.success) {
          status.classList.add("ok");
          status.textContent = status.dataset.success ?? "";
          form.reset();
        } else {
          throw new Error(data.message ?? "error");
        }
      } catch {
        status.classList.add("err");
        status.textContent = status.dataset.error ?? "";
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = submitLabel;  // restaure le libellé + la flèche (span)
      }
    });
  }
</script>
