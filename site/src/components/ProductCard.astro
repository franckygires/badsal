---
import type { Dict, Locale } from "../i18n/types";
import type { Product } from "../data/products";
import { productImage } from "../data/products";

interface Props {
  product: Product;
  locale: Locale;
  dict: Dict;
  /** "home" = phares (4/3, sans badge) · "list" = pages Export/Import (16/10, badge) */
  variant?: "home" | "list";
}

const { product, locale, dict, variant = "list" } = Astro.props;
const t = dict;
const badge = product.category === "import" ? t.nav.importLabel : t.nav.exportLabel;
const panelId = `pc-${product.slug}`;
const img = productImage(product.slug);
---

<article id={product.slug} class:list={["pc", `pc-${variant}`, { "pc-has-photo": !!img }]}>
  <div class="pc-photo">
    {img ? (
      <picture>
        {!img.endsWith(".png") && <source type="image/webp" srcset={"/images/" + img + ".webp"} />}        <img src={"/images/" + img + (img.endsWith(".png") ? "" : ".jpg")} alt={product.name[locale]} loading="lazy" decoding="async" />
      </picture>
    ) : (
      <span class="pc-photo-label">Photo produit</span>
    )}
    {variant === "list" && <span class="pc-badge">{badge}</span>}
  </div>
  <div class="pc-body">
    <h3 class="pc-title">{product.name[locale]}</h3>
    {product.cat && <span class="pc-cat">{product.cat[locale]}</span>}
    <p class="pc-short">{product.short[locale]}</p>

    <div class="pc-panel" id={panelId} hidden>
      <p class="pc-long">{product.long[locale]}</p>
    </div>

    <div class="pc-actions">
      <button class="pc-btn pc-toggle" type="button" aria-expanded="false" aria-controls={panelId}>
        <span class="pc-toggle-more">{t.common.learnMore}</span>
        <span class="pc-toggle-less">{t.common.showLess}</span>
      </button>
    </div>
  </div>
</article>

<style>
  .pc {
    display: flex; flex-direction: column; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .pc-photo {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary-soft), var(--color-primary-deep));
  }
  .pc-home .pc-photo { aspect-ratio: 4 / 3; }
  .pc-list .pc-photo { aspect-ratio: 16 / 10; }
  .pc-photo picture, .pc-photo img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .pc-photo-label {
    position: absolute; left: 16px; bottom: 14px; z-index: 2;
    font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55);
  }
  .pc-badge {
    position: absolute; right: 16px; bottom: 14px; z-index: 2;
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-accent-soft); background: rgba(15, 42, 32, 0.65); padding: 4px 9px; border-radius: 999px;
  }

  .pc-body { padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .pc-title { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--color-text); margin: 0; }
  .pc-cat { font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em; color: var(--color-accent-deep); }
  .pc-short {
    font-size: 14px; line-height: 1.55; color: var(--color-text-muted); margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .pc-panel { border-top: 1px solid var(--color-border); margin-top: 4px; padding-top: 14px; }
  .pc-long { font-size: 14px; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 14px; }

  .pc-actions { display: flex; gap: 10px; margin-top: auto; padding-top: 6px; }
  .pc-btn {
    flex: 1; text-align: center; display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-body); font-size: 13px; font-weight: 600; padding: 10px 12px;
    border-radius: 6px; cursor: pointer; text-decoration: none;
    transition: background var(--dur-base) var(--ease-standard);
  }
  .pc-toggle { color: var(--color-primary); background: transparent; border: 1.5px solid var(--color-primary); }
  .pc-toggle:hover { background: var(--color-primary-tint); }

  .pc-toggle-less { display: none; }
  .pc[data-open] .pc-short { -webkit-line-clamp: unset; line-clamp: unset; }
  .pc[data-open] .pc-toggle-more { display: none; }
  .pc[data-open] .pc-toggle-less { display: inline; }
</style>

<script>
  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".pc-toggle");
    if (!btn) return;
    const card = btn.closest(".pc");
    const panel = card && card.querySelector(".pc-panel");
    if (!card || !panel) return;
    const open = card.toggleAttribute("data-open");
    btn.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  });
</script>
